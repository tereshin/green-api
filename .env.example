# Скопируйте в .env.local и заполните. Файлы .env* (кроме этого) не коммитятся.
#
# Всё с префиксом VITE_ встраивается в клиентский бандл и ВИДНО ПОЛЬЗОВАТЕЛЮ.
# Никаких секретов (API-токены, пароли, приватные ключи) здесь быть не должно.

# Базовый URL BFF/бэкенда (same-origin или с настроенным CORS + credentials).
# Значение вшивается в бандл на этапе docker build, это не секрет.
VITE_API_BASE_URL=https://4100.api.green-api.com

# Имя docker-сети Nginx Proxy Manager. Узнать: docker network ls
# Нужно только в .env на сервере, рядом с docker-compose.yml.
# PROXY_NETWORK=web
